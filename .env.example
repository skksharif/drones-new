# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production. .env.local is git-ignored; this file is the
# template and must never hold real values.

# --- Catalogue storage ---------------------------------------------------
# Leave MONGODB_URI unset to run against the committed seed catalogue in data/.
MONGODB_URI=
MONGODB_DB=agrosky

# --- Admin access --------------------------------------------------------
# Generate ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET with:
#   npm run admin:password
# The hash is not the password and cannot be reversed or replayed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Image uploads -------------------------------------------------------
# From the Cloudinary dashboard. Without these the product form still works,
# but images have to be pasted in as paths under /public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.agroskydroneaspirant.com
